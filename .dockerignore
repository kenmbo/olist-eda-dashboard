# .dockerignore (Backend)

# Ignore Python cache and virtual environments
__pycache__/
src/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Ignore local environment variables (keep secrets out of the image!)
.env
.env.local

# Ignore git history
.git/
.gitignore

# Frontend
frontend/

# Notebook files
data/
.ipynb_checkpoints/
olist-eda.ipynb

